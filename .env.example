# Vercel access token. Create one at https://vercel.com/account/tokens
# It is only read on the server and never sent to the browser.
VERCEL_TOKEN=

# Password to open the dashboard. Optional locally, required when deployed.
DASHBOARD_PASSWORD=

# Optional. Where the history is stored. Defaults to a local file,
# pulseboard.db. Set a Turso URL (libsql://...) and its token when deploying.
DATABASE_URL=
DATABASE_AUTH_TOKEN=